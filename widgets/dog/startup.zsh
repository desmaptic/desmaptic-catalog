dog_js='
ObjC.import("AppKit");
ObjC.import("QuartzCore");
ObjC.import("CoreGraphics");
ObjC.bindFunction("getppid", ["int", []]);

// The dog on the Mac screen: one see-through window per display above everything (full screen apps too, every
// Space), clicks pass through, never focused, no Dock icon. The dog is one layer in every window, so it runs from
// one display onto the next. A run is a few Core Animation glides (speeding up, galloping on, braking) that the
// window server plays at the refresh rate of the display; this process looks ten times a second while the dog
// runs (a new glide only when the pointer has gone elsewhere), five while it sits and three while it sleeps,
// and swaps the pictures. The pictures are drawn once into bitmaps (a rectangle per run of pixels) and shown
// magnified without smoothing, so every pixel stays sharp. A CGImage handed to an id argument goes through
// ObjC.castRefToObject (a bare ref arrives as a dictionary and draws nothing), CFRelease from JXA crashes, and
// every colour is a CoreGraphics one kept for the whole process.
//
// argv: <mode> <file> <palette> <pictures>
//   live <file>   the dog, while the loop keeps <file>. Gone: the dog runs off the screen and the process quits
//                 ("bye"); back while it runs off: it comes back. Prints "up" once the dog is out and "." every
//                 second; quits at once when the loop that started it is gone (its parent changes).
//   ghost <file>  the same with no window at all: what the dog does goes to stderr, a line per change.
//   sheet <png>   every picture, facing right and left, on light and on dark, magnified (4 times for 80 x 60
//                 pictures). No window.
//   sim           the dog chasing a made-up pointer over two made-up displays for 85 s, a line per change.

const PT = 1;           // points per pixel of a picture: the 80 x 60 pictures are 80 x 60 pt on the screen
const RUN = 340;        // pt/s: the dog at full gallop
const DOZE = 10;        // s: the pointer still this long, the dog lies down and falls asleep
const ACC = RUN / 0.25;               // pt/s2: from a stand to full gallop in a quarter of a second
const DEC = RUN * RUN / (2 * 70);     // pt/s2: from full gallop to a stand in 70 pt
const STEP = 0.1;       // s: the running dog looks where the pointer is this often
const LEAVE_MAX = 8;    // s: a dog sent away is gone after this long even if it has not reached the edge
// Distances that go with the size of the dog, as shares of the width of a picture on the screen (set in run()):
// the middle of the dog to the pointer where it stops and sits down; the pointer this far from the sitting dog
// makes it run again; the way run per running picture (the pictures follow the ground, so the feet never slide;
// at most RUN * STEP, one picture a look at full gallop).
const NEAR_W = 0.7, AWAY_W = 1.28, STRIDE_W = 0.42;
let NEAR = 0, AWAY = 0, STRIDE = 0;   // pt
const HAPPY_CHANCE = 0.6;   // woken by the pointer, the dog bounces for joy this often before it runs

// What the dog does: [picture, seconds] in order. Pictures are named in the text above this program. The gallop
// is three pictures: stretched out, the front feet landing, gathered under the body.
const RUN_PICS = ["run1", "run2", "run3"];
// While it sits or lies (its rest pose), now and then one of these, picked at random from IDLE; rest: the pose
// it is in afterwards.
const ACTS = {
  pant: { list: repeat([["pant1", 0.14], ["pant2", 0.14]], 9) },
  wag: { list: repeat([["wag1", 0.12], ["wag2", 0.12]], 6) },
  tilt: { list: [["tilt", 1.2]] },
  scratch: { list: repeat([["scratch1", 0.07], ["scratch2", 0.07]], 9).concat([["blink", 0.25]]) },
  blink: { list: [["blink", 0.16]] },
  down: { list: [["lie", 0.3]], rest: "lie" },
  liepant: { list: repeat([["lie2", 0.14], ["lie3", 0.14]], 9) },
  lieblink: { list: [["lieblink", 0.18]] },
};
const IDLE = {
  sit: ["pant", "pant", "pant", "tilt", "tilt", "scratch", "scratch", "wag", "blink", "down"],
  lie: ["liepant", "liepant", "lieblink", "lieblink"],
};
const ARRIVE = repeat([["wag1", 0.12], ["wag2", 0.12]], 7);   // at the pointer: it sits and wags
const DOZE_OFF = {                                               // from sitting or lying down to sleep
  sit: [["yawn", 1.0], ["sit", 0.3], ["lie", 1.0], ["lieblink", 0.5], ["lie", 0.3], ["lieblink", 0.9]],
  lie: [["lieblink", 0.5], ["lie", 0.4], ["lieblink", 1.0]],
};
const SLEEP = [["sleep1", 1.4], ["sleep2", 1.4]];                // over and over, while z letters float up
const WAKE = [["lieblink", 0.25], ["lie", 0.25], ["alert", 0.3]];
const HAPPY = [["bow", 0.5], ["jump", 0.18], ["alert", 0.14], ["jump", 0.18], ["alert", 0.25]];
const START = { sit: [["alert", 0.15]], lie: [["sit", 0.12], ["alert", 0.12]] };   // up and off
const Z_RISE = 2.7, Z_GAP = 0.9;                    // s: one z floats up this long; the next starts this much later

function repeat(list, n) { let all = []; for (let i = 0; i < n; i++) all = all.concat(list); return all; }
function length(list) { return list.reduce((s, a) => s + a[1], 0); }

const out = $.NSFileHandle.fileHandleWithStandardOutput;
const err = $.NSFileHandle.fileHandleWithStandardError;
function say(text) { out.writeData($(text + "\n").dataUsingEncoding($.NSUTF8StringEncoding)); }
function complain(text) { err.writeData($("dog: " + text + "\n").dataUsingEncoding($.NSUTF8StringEncoding)); }

// ---- The pictures ----------------------------------------------------------------------------------------

// { colours: letter -> [r, g, b], pics: name -> rows, w, h, problems }. Dog pictures are all the size of "sit".
function readPictures(paletteText, picturesText) {
  const colours = {}, pics = {}, problems = [];
  for (const line of (paletteText || "").split("\n")) {
    const m = line.match(/^\s*(\S)\s+#?([0-9A-Fa-f]{6})(\s|$)/);
    if (m) colours[m[1]] = [0, 2, 4].map(i => parseInt(m[2].substr(i, 2), 16) / 255);
  }
  let name = null;
  for (const raw of (picturesText || "").split("\n")) {
    const line = raw.trim();
    if (!line) continue;
    const head = line.match(/^=\s*(\S+)/);
    if (head) { name = head[1]; pics[name] = []; continue; }
    if (name) pics[name].push(line);
    else problems.push("a row comes before the first picture name");
  }
  const size = rows => [rows.reduce((m, r) => Math.max(m, r.length), 0), rows.length];
  const [w, h] = pics.sit ? size(pics.sit) : [0, 0];
  const needed = new Set(["sit", "z"].concat(RUN_PICS));
  const lists = [ARRIVE, SLEEP, WAKE, HAPPY].concat(Object.values(DOZE_OFF), Object.values(START), Object.values(ACTS).map(a => a.list));
  for (const list of lists) for (const [p] of list) needed.add(p);
  for (const a of Object.values(ACTS)) if (a.rest) needed.add(a.rest);
  for (const p of needed) if (!pics[p]) problems.push("no picture named " + p);
  for (const [n, rows] of Object.entries(pics)) {
    if (n !== "z" && (size(rows)[0] !== w || rows.length !== h)) problems.push("picture " + n + " is not " + w + " x " + h + " like sit");
    rows.forEach((r, y) => { for (const c of r) if (c !== "." && !colours[c]) problems.push("picture " + n + ", row " + (y + 1) + ": no colour for " + c); });
  }
  return { colours: colours, pics: pics, w: w, h: h, problems: problems };
}

const space = $.CGColorSpaceCreateWithName($.kCGColorSpaceSRGB);

// The CoreGraphics colours of the palette, made once and kept.
function cgColours(art) {
  const cg = {};
  for (const [c, v] of Object.entries(art.colours)) cg[c] = $.CGColorCreateSRGB(v[0], v[1], v[2], 1);
  return cg;
}

// One picture into a bitmap of its own size, a pixel per letter; flip: the mirror image (the dog facing left).
function bitmap(rows, cg, flip) {
  const w = rows.reduce((m, r) => Math.max(m, r.length), 0), h = rows.length;
  const ctx = $.CGBitmapContextCreate(null, w, h, 8, 0, space, 1);      // RGBA, premultiplied
  rows.forEach((row, y) => {
    for (let x = 0; x < row.length;) {
      const c = row[x];
      let n = 1;
      while (x + n < row.length && row[x + n] === c) n++;
      if (c !== "." && cg[c]) {
        $.CGContextSetFillColorWithColor(ctx, cg[c]);
        $.CGContextFillRect(ctx, $.CGRectMake(flip ? w - x - n : x, h - 1 - y, n, 1));   // y grows upward here
      }
      x += n;
    }
  });
  return $.CGBitmapContextCreateImage(ctx);
}

// name -> { r: right, l: left }, as objects ready for setContents.
function images(art) {
  const cg = cgColours(art), all = {};
  for (const [n, rows] of Object.entries(art.pics)) {
    all[n] = { r: ObjC.castRefToObject(bitmap(rows, cg, false)), l: ObjC.castRefToObject(bitmap(rows, cg, n !== "z")) };
  }
  return all;
}

// Every picture facing right and left, magnified (a picture about 320 px wide), on light and dark squares, four to
// a row.
function sheet(art, file) {
  const cg = cgColours(art), names = Object.keys(art.pics), pad = 4;
  const S = Math.max(2, Math.round(320 / Math.max(1, art.w)));
  const cw = (art.w + pad) * S, ch = (art.h + pad) * S, per = 4, rows = Math.ceil(names.length * 2 / per);
  const ctx = $.CGBitmapContextCreate(null, cw * per, ch * rows, 8, 0, space, 1);
  const grounds = [$.CGColorCreateSRGB(0.93, 0.93, 0.95, 1), $.CGColorCreateSRGB(0.15, 0.16, 0.19, 1)];
  $.CGContextSetInterpolationQuality(ctx, 1);                          // none: sharp pixels
  let i = 0;
  for (const n of names) {
    for (const flip of [false, true]) {
      const x = (i % per) * cw, y = (rows - 1 - Math.floor(i / per)) * ch, rows2 = art.pics[n];
      const w = rows2.reduce((m, r) => Math.max(m, r.length), 0), h = rows2.length;
      $.CGContextSetFillColorWithColor(ctx, grounds[(i + Math.floor(i / per)) % 2]);
      $.CGContextFillRect(ctx, $.CGRectMake(x, y, cw, ch));
      $.CGContextDrawImage(ctx, $.CGRectMake(x + pad / 2 * S, y + pad / 2 * S, w * S, h * S), bitmap(rows2, cg, flip && n !== "z"));
      i++;
    }
  }
  const rep = $.NSBitmapImageRep.alloc.initWithCGImage(ObjC.castRefToObject($.CGBitmapContextCreateImage(ctx)));
  const ok = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $({})).writeToFileAtomically($(file), true);
  if (!ok) { complain("could not write " + file); return; }
  say(names.map(n => n + " (right, left)").join(", "));
}

// ---- What the dog does -----------------------------------------------------------------------------------
// Positions are the Mac global screen coordinates in points (NSEvent.mouseLocation: y grows upward, one space
// for all displays); the dog is at the middle of its picture.

let HALF_W = 0, HALF_H = 0;   // half the picture on the screen (set in run()): the dog keeps this far inside a display

function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
function rand(lo, hi) { return lo + Math.random() * (hi - lo); }

// The display a point is on, or the nearest one.
function displayOf(world, x, y) {
  let best = world[0], gap = Infinity;
  for (const s of world) {
    const dx = Math.max(s.x - x, 0, x - s.x - s.w), dy = Math.max(s.y - y, 0, y - s.y - s.h);
    if (dx === 0 && dy === 0) return s;
    if (dx * dx + dy * dy < gap) { gap = dx * dx + dy * dy; best = s; }
  }
  return best;
}
function onSomeDisplay(world, x, y) { return world.some(s => x >= s.x && x <= s.x + s.w && y >= s.y && y <= s.y + s.h); }

// A new dog: it runs in from the side of the display the pointer is on, the side nearer to the pointer.
function newDog(t, p, world) {
  const s = displayOf(world, p.x, p.y), fromLeft = p.x - s.x < s.x + s.w - p.x;
  const x = fromLeft ? s.x - HALF_W - 4 : s.x + s.w + HALF_W + 4, y = clamp(p.y, s.y + HALF_H, s.y + s.h - HALF_H);
  return {
    mode: "run", pic: RUN_PICS[0], rest: "sit", face: fromLeft ? 1 : -1, zzz: false, play: null,
    seen: { x: p.x, y: p.y }, moved: t, rested: t, idleAt: 0, dozed: 0, slept: 0, goal: null, leftAt: 0,
    motion: { x0: x, y0: y, t0: t, x1: x, y1: y, t1: t, a: 1 }, aim: null, aimAt: 0, replan: false, frame: 0, ran: 0, last: { x: x, y: y },
  };
}

// The dog moves in glides: straight from (x0, y0) at t0 to (x1, y1) at t1 at an even acceleration. a is its
// speed at the start against the mean speed (0: from a stand, 1: even, 2: to a stand); the way covered after a
// share k of the time is a k + (1 - a) k^2, which is also the timing curve Core Animation gets (glideCurve).
function where(c, t) {
  const m = c.motion;
  if (t >= m.t1) return { x: m.x1, y: m.y1 };
  const k = Math.max(0, (t - m.t0) / (m.t1 - m.t0)), q = m.a * k + (1 - m.a) * k * k;
  return { x: m.x0 + (m.x1 - m.x0) * q, y: m.y0 + (m.y1 - m.y0) * q };
}
function speedAt(c, t) {
  const m = c.motion, T = m.t1 - m.t0, L = Math.hypot(m.x1 - m.x0, m.y1 - m.y0);
  if (T <= 0 || L <= 0) return 0;
  if (t >= m.t1) return t - m.t1 < 0.15 ? (2 - m.a) * L / T : 0;
  return (m.a + 2 * (1 - m.a) * Math.max(0, (t - m.t0) / T)) * L / T;
}

// The next glide toward goal: speeding up (to full gallop, or as fast as the way leaves room to stop), running
// on, or braking to a stand at the goal. The speed carries over from the glide before, less what a turn costs:
// straight back starts from a stand.
function plan(c, t, at, goal) {
  const dx = goal.x - at.x, dy = goal.y - at.y, d = Math.hypot(dx, dy), ux = dx / d, uy = dy / d;
  const m = c.motion, ml = Math.hypot(m.x1 - m.x0, m.y1 - m.y0), brake = v => v * v / (2 * DEC);
  let v0 = speedAt(c, t);
  if (v0 > 0 && ml > 0) v0 *= Math.max(0, ((m.x1 - m.x0) * ux + (m.y1 - m.y0) * uy) / ml);
  let L = d, v1 = 0;
  if (!(v0 > 1 && d <= brake(v0) + 0.5)) {
    if (v0 < RUN - 1) {
      v1 = Math.min(RUN, Math.sqrt((2 * ACC * DEC * d + DEC * v0 * v0) / (ACC + DEC)));
      L = Math.min(d, (v1 * v1 - v0 * v0) / (2 * ACC));
    } else {
      v0 = RUN;
      L = d - brake(RUN);
      v1 = RUN;
      if (L < 0.5) { L = d; v1 = 0; }
    }
    if (L < 0.5) { L = d; v1 = 0; }
  }
  if (v0 + v1 < 20) { v0 = Math.max(v0, 20 - v1); }                    // a step of a few points: no crawl
  const T = 2 * L / (v0 + v1), a = 2 * v0 / (v0 + v1);
  c.motion = { x0: at.x, y0: at.y, t0: t, x1: at.x + ux * L, y1: at.y + uy * L, t1: t + T, a: a };
  c.aim = { x: goal.x, y: goal.y };
  c.aimAt = t;
  if (Math.abs(dx) > d * 0.2) c.face = dx > 0 ? 1 : -1;
  return { x0: at.x, y0: at.y, x1: c.motion.x1, y1: c.motion.y1, dur: T, a: a };
}

// Plays a list of [picture, seconds]; at its end the dog goes to mode next, or (no next) back to its rest pose,
// which rest changes. soft: the pointer running away cuts it short.
function play(c, t, list, next, soft, rest) {
  c.play = { list: list, i: 0, until: t + list[0][1], next: next || null, soft: !!soft, rest: rest || null };
  c.pic = list[0][0];
}
function advance(c, t) {
  const p = c.play;
  while (p && c.play === p && t >= p.until) {
    if (++p.i < p.list.length) { p.until += p.list[p.i][1]; c.pic = p.list[p.i][0]; continue; }
    c.play = null;
    if (p.rest) c.rest = p.rest;
    if (p.next) enter(c, p.next, p.until);
    else if (c.mode === "sit") c.pic = c.rest;                         // the act is over: sitting (or lying) again
  }
}
function enter(c, mode, t) {
  c.mode = mode;
  if (mode === "sleep") { c.slept = t; c.zzz = true; play(c, t, SLEEP); }
  if (mode === "sit") { c.rest = "sit"; c.pic = "sit"; c.rested = t; c.idleAt = t + rand(1.2, 2.5); }
}

// Where the dog sits down: NEAR from the pointer on the side it comes from, its whole picture on the display
// the pointer is on (in a corner it sits a little closer).
function seat(c, p, at, world) {
  const s = displayOf(world, p.x, p.y);
  let ux = at.x - p.x, uy = at.y - p.y;
  const l = Math.hypot(ux, uy);
  if (l < 0.01) { ux = -c.face; uy = 0; } else { ux /= l; uy /= l; }
  const x = clamp(p.x + ux * NEAR, s.x + HALF_W, s.x + s.w - HALF_W), y = clamp(p.y + uy * NEAR, s.y + HALF_H, s.y + s.h - HALF_H);
  return { x: Math.round(x * 2) / 2, y: Math.round(y * 2) / 2 };   // whole pixels of a Retina display
}

// Where a dog sent away runs to: just past the nearest edge of its display that has no display beyond it.
function exit(at, world) {
  const s = displayOf(world, at.x, at.y), m = 8;
  const ways = [
    { x: s.x - HALF_W - m, y: at.y, d: at.x - s.x },
    { x: s.x + s.w + HALF_W + m, y: at.y, d: s.x + s.w - at.x },
    { x: at.x, y: s.y - HALF_H - m, d: at.y - s.y },
    { x: at.x, y: s.y + s.h + HALF_H + m, d: s.y + s.h - at.y },
  ].filter(g => !onSomeDisplay(world, g.x, g.y)).sort((a, b) => a.d - b.d);
  return ways.length ? ways[0] : null;
}

// One look at the world at time t (the pointer at p; leaving: sent away). Changes c (mode, pic, face, zzz) and
// returns what else to do: { glide: { x0, y0, x1, y1, dur } or null, done }.
function think(c, t, p, leaving, world) {
  const o = { glide: null, done: false };
  if (Math.hypot(p.x - c.seen.x, p.y - c.seen.y) > 2) { c.seen = { x: p.x, y: p.y }; c.moved = t; }
  let at = where(c, t);
  if (leaving && c.mode !== "leave") {
    const lying = c.mode === "sleep" || c.mode === "dozing" || (c.mode === "sit" && c.rest === "lie");
    c.zzz = false;
    c.mode = "leave";
    c.leftAt = t;
    c.goal = exit(at, world);
    c.play = null;
    if (t >= c.motion.t1) play(c, t, START[lying ? "lie" : "sit"], null);   // up and off, unless already running
  } else if (!leaving && c.mode === "leave") {
    c.play = null;
    enter(c, "run", t);                                  // called back: it turns round
  }
  advance(c, t);
  if (c.mode === "sleep") {
    if (c.moved > c.slept) { c.zzz = false; play(c, t, Math.random() < HAPPY_CHANCE ? WAKE.concat(HAPPY) : WAKE, "sit"); c.mode = "woken"; }
    else if (!c.play) play(c, t, SLEEP);
    return o;
  }
  if (c.mode === "dozing" && c.moved > c.dozed) { c.play = null; enter(c, "sit", t); }   // the pointer moved: awake again
  if (c.mode === "woken" || c.mode === "dozing") return o;          // the picture list plays out first
  if (c.mode === "sit") {
    if (c.play && !c.play.soft) return o;
    const dx = p.x - at.x, d = Math.hypot(dx, p.y - at.y);
    if (d > AWAY) { play(c, t, START[c.rest], "run"); return o; }
    if (Math.abs(dx) > 20) c.face = dx > 0 ? 1 : -1;                // turns to the pointer
    if (c.play) return o;
    if (t - Math.max(c.moved, c.rested) >= DOZE) { play(c, t, DOZE_OFF[c.rest], "sleep"); c.mode = "dozing"; c.dozed = t; return o; }
    if (t >= c.idleAt) {
      const names = IDLE[c.rest], act = ACTS[names[Math.floor(Math.random() * names.length)]];
      play(c, t, act.list, null, true, act.rest);
      c.idleAt = t + length(act.list) + rand(1.5, 3.5);
    }
    return o;
  }
  // run, leave
  if (c.play) return o;                                               // the start (up and off) plays out
  if (c.mode === "leave" && (!c.goal || t - c.leftAt > LEAVE_MAX)) { o.done = true; return o; }
  const goal = c.mode === "leave" ? c.goal : seat(c, p, at, world);
  const d = Math.hypot(goal.x - at.x, goal.y - at.y), stopped = t >= c.motion.t1 - 0.002;
  if (stopped && d < (c.mode === "leave" ? 2 : 10)) {                 // there (a few points short is close enough)
    if (c.mode === "leave") { o.done = true; return o; }
    enter(c, "sit", t);
    play(c, t, ARRIVE, null, true);                                   // it sits down and wags
    c.idleAt = t + length(ARRIVE) + rand(1.2, 2.5);
    return o;
  }
  if (stopped || c.replan || (c.aim && Math.hypot(goal.x - c.aim.x, goal.y - c.aim.y) > 8 && t - c.aimAt >= 0.25)) {
    c.replan = false;
    o.glide = plan(c, t, at, goal);
    at = where(c, t);
  }
  c.ran += Math.hypot(at.x - c.last.x, at.y - c.last.y);               // the next running picture every STRIDE
  c.last = at;
  if (c.ran >= STRIDE || !RUN_PICS.includes(c.pic)) {
    c.ran = clamp(c.ran - STRIDE, 0, STRIDE / 2);
    c.frame = (c.frame + 1) % RUN_PICS.length;
    c.pic = RUN_PICS[c.frame];
  }
  return o;
}

// How long until the dog needs another look.
function nextLook(c, t) {
  const running = c.mode === "run" || c.mode === "leave";
  let next = running ? STEP : c.mode === "sleep" ? 0.33 : 0.2;
  if (c.play) next = Math.min(next, c.play.until - t);
  if (running && c.motion.t1 > t) next = Math.min(next, c.motion.t1 - t);   // right when a glide ends
  return Math.max(0.01, next);
}

// ---- The screen --------------------------------------------------------------------------------------------

function number(x) { return $.NSNumber.numberWithDouble(x); }
function point(x, y) { return $.NSValue.valueWithPoint($.CGPointMake(x, y)); }

// "x y w h scale" for every display: when it changes, the windows are made again.
function displays() {
  const screens = $.NSScreen.screens, list = [];
  for (let i = 0; i < Number(screens.count); i++) {
    const s = screens.objectAtIndex(i), f = s.frame;
    list.push({ x: f.origin.x, y: f.origin.y, w: f.size.width, h: f.size.height, screen: s });
  }
  return list;
}
function layoutOf(world) { return world.map(s => [s.x, s.y, s.w, s.h, s.screen.backingScaleFactor].join(" ")).join(","); }

// The dog layer (80 x 60 pt, its middle at its position) with its three z letters, hidden until placed.
function makeDog(im, art) {
  const dog = $.CALayer.layer;
  dog.setBounds($.CGRectMake(0, 0, art.w * PT, art.h * PT));
  dog.setMagnificationFilter($.kCAFilterNearest);     // big sharp pixels, never smoothed
  dog.setMinificationFilter($.kCAFilterNearest);
  dog.setPosition($.CGPointMake(-1000, -1000));
  const zs = [];
  const zw = art.pics.z.reduce((m, r) => Math.max(m, r.length), 0), zh = art.pics.z.length;
  for (let i = 0; i < 3; i++) {
    const z = $.CALayer.layer;
    z.setBounds($.CGRectMake(0, 0, zw * PT, zh * PT));
    z.setContents(im.z.r);
    z.setMagnificationFilter($.kCAFilterNearest);
    z.setMinificationFilter($.kCAFilterNearest);
    z.setOpacity(0);
    dog.addSublayer(z);
    zs.push(z);
  }
  return { dog: dog, zs: zs };
}

// A window over one display with the dog in it.
function makeWindow(s, im, art) {
  const w = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(s.screen.frame, 0, 2, false);   // borderless, buffered
  w.setOpaque(false);
  w.setBackgroundColor($.NSColor.clearColor);
  w.setHasShadow(false);
  w.setIgnoresMouseEvents(true);
  w.setReleasedWhenClosed(false);
  w.setLevel(1000);                                 // the screen saver level: above everything
  w.setCollectionBehavior(1 | 16 | 64 | 256);       // all Spaces, stationary, out of the window cycle, full screen
  const view = w.contentView;
  view.setWantsLayer(true);
  const part = makeDog(im, art);
  view.layer.addSublayer(part.dog);
  w.orderFrontRegardless;
  part.window = w;
  part.x = s.x;
  part.y = s.y;
  return part;
}

// Where the z letters start, in pt from the bottom left corner of the dog facing right: a little above the right
// end of the top row of the sleeping dog (the tip of its ear).
function zStart(art) {
  const rows = art.pics.sleep1 || art.pics.sit || [], zh = art.pics.z.length * PT;
  const top = rows.findIndex(r => /[^.]/.test(r));
  if (top < 0) return { x: art.w * PT * 0.76, y: art.h * PT * 0.58 };
  const m = rows[top].match(/[^.]\.*$/);
  return { x: (m ? m.index + 1 : art.w * 0.76) * PT, y: (art.h - top) * PT + zh * 0.25 };
}

// The z letters of a sleeping dog float up from its head and fade, one after another, for as long as it sleeps:
// animations the window server runs by itself.
function zzzOn(parts, face, art) {
  const W = art.w * PT, at = zStart(art);
  const x0 = face > 0 ? at.x : W - at.x, y0 = at.y, rise = 30, drift = 14 * face;
  const easeOut = $.CAMediaTimingFunction.functionWithName($.kCAMediaTimingFunctionEaseOut);
  const begin = $.CACurrentMediaTime();
  for (const p of parts) {
    p.zs.forEach((z, i) => {
      const move = $.CABasicAnimation.animationWithKeyPath("position");
      move.setFromValue(point(x0, y0));
      move.setToValue(point(x0 + drift, y0 + rise));
      move.setTimingFunction(easeOut);
      const fade = $.CAKeyframeAnimation.animationWithKeyPath("opacity");
      fade.setValues($([0, 1, 1, 0].map(number)));
      fade.setKeyTimes($([0, 0.15, 0.6, 1].map(number)));
      const grow = $.CABasicAnimation.animationWithKeyPath("transform.scale");
      grow.setFromValue(number(0.55));
      grow.setToValue(number(1.15));
      const all = $.CAAnimationGroup.animation;
      all.setAnimations($([move, fade, grow]));
      all.setDuration(Z_RISE);
      all.setRepeatCount(1e6);
      all.setBeginTime(begin + 0.6 + i * Z_GAP);
      z.setPosition($.CGPointMake(x0, y0));
      z.addAnimationForKey(all, "zzz");
    });
  }
}
function zzzOff(parts) { for (const p of parts) for (const z of p.zs) z.removeAnimationForKey("zzz"); }

// Nobody can see the dog: the screen is locked (the lock screen covers it) or every display sleeps. Whatever
// cannot be read counts as seen.
function hidden() {
  try {
    const session = ObjC.castRefToObject($.CGSessionCopyCurrentDictionary());    // a small copy, never released
    const locked = session.objectForKey($("CGSSessionScreenIsLocked"));
    if (!locked.isNil() && locked.boolValue) return true;
    const screens = $.NSScreen.screens, n = Number(screens.count);
    for (let i = 0; i < n; i++) {
      const id = screens.objectAtIndex(i).deviceDescription.objectForKey($("NSScreenNumber"));
      if (id.isNil() || !$.CGDisplayIsAsleep(id.unsignedIntValue)) return false;
    }
    return n > 0;
  } catch (e) { return false; }
}

// AppKit learns about added and removed displays from events: take the waiting ones without blocking.
function takeEvents() {
  const app = $.NSApplication.sharedApplication;
  for (let i = 0; i < 64; i++) {
    const e = app.nextEventMatchingMaskUntilDateInModeDequeue($.NSEventMaskAny, $.NSDate.distantPast, $.NSDefaultRunLoopMode, true);
    if (e.isNil()) break;
  }
}

// The Core Animation curve of a glide with start speed share a (see where): the bezier through (1/3, a/3) and
// (2/3, (1 + a)/3) is exactly a k + (1 - a) k^2.
function glideCurve(a) { return $.CAMediaTimingFunction.functionWithControlPoints(1 / 3, a / 3, 2 / 3, (1 + a) / 3); }

// The dog in one window (p: its layers and the corner of its display): the picture when it changed, and the glide
// (from where the dog is to where it runs) or, the first time, its place.
function paint(p, c, glide, curve, at, change, first, im) {
  if (change) p.dog.setContents(c.face > 0 ? im[c.pic].r : im[c.pic].l);
  if (glide) {
    const a = $.CABasicAnimation.animationWithKeyPath("position");
    a.setFromValue(point(glide.x0 - p.x, glide.y0 - p.y));
    a.setToValue(point(glide.x1 - p.x, glide.y1 - p.y));
    a.setDuration(glide.dur);
    a.setTimingFunction(curve);
    p.dog.setPosition($.CGPointMake(glide.x1 - p.x, glide.y1 - p.y));
    p.dog.addAnimationForKey(a, "run");
  } else if (first) {
    p.dog.setPosition($.CGPointMake(at.x - p.x, at.y - p.y));
  }
}

// Shows the dog as it is now in every window: one transaction, flushed at once (there is no run loop).
function Screen(art, ghost) {
  const im = ghost ? null : images(art);
  let parts = [], shown = { pic: "", face: 0, zzz: false }, last = -1, t0 = -1;
  const me = {
    build(world) {
      me.takeDown();
      if (!ghost) {
        $.CATransaction.begin;
        $.CATransaction.setDisableActions(true);
        for (const s of world) {
          try { parts.push(makeWindow(s, im, art)); } catch (e) { complain("no dog on a display: " + e); }
        }
        $.CATransaction.commit;
        $.CATransaction.flush;
      }
      shown = { pic: "", face: 0, zzz: false };
      return ghost || parts.length > 0;
    },
    show(c, o, t) {
      const at = where(c, t), change = c.pic !== shown.pic || c.face !== shown.face;
      if (ghost) {
        if (t0 < 0) t0 = t;
        if (change || c.zzz !== shown.zzz || (o.glide && t - last >= 1)) {
          last = t;
          complain([(t - t0).toFixed(2), c.mode, c.pic, c.face > 0 ? "right" : "left", Math.round(at.x), Math.round(at.y), c.zzz ? "zzz" : ""].join(" "));
        }
      } else {
        $.CATransaction.begin;
        $.CATransaction.setDisableActions(true);
        const curve = o.glide ? glideCurve(o.glide.a) : null;
        for (const p of parts) paint(p, c, o.glide, curve, at, change, !shown.pic, im);
        if (c.zzz && !shown.zzz) zzzOn(parts, c.face, art);
        if (!c.zzz && shown.zzz) zzzOff(parts);
        $.CATransaction.commit;
        $.CATransaction.flush;
      }
      shown = { pic: c.pic, face: c.face, zzz: c.zzz };
    },
    takeDown() {
      if (parts.length) {
        $.CATransaction.begin;
        $.CATransaction.setDisableActions(true);
        for (const p of parts) p.window.orderOut(null);
        $.CATransaction.commit;
        $.CATransaction.flush;
      }
      parts = [];
    },
  };
  return me;
}

function live(go, art, ghost) {
  const files = $.NSFileManager.defaultManager, parent = $.getppid();
  const wanted = () => files.fileExistsAtPath($(go));
  if (!go || !wanted()) return;
  if (!ghost) $.NSApplication.sharedApplication.setActivationPolicy(1);   // accessory: no Dock icon, never active
  const info = $.NSProcessInfo.processInfo, clock = () => Number(info.systemUptime);
  let world = displays(), layout = layoutOf(world);
  if (!world.length) { complain("no display for the dog"); return; }
  const screen = Screen(art, ghost);
  if (!screen.build(world)) { complain("no display for the dog"); return; }
  const pointer = () => { const m = $.NSEvent.mouseLocation; return { x: Number(m.x), y: Number(m.y) }; };
  let t = clock();
  const c = newDog(t, pointer(), world);
  let leaving = false, seen = true, look = t, beat = t + 1, survey = t + 2;
  screen.show(c, { glide: null }, t);
  try { say("up"); } catch (e) { screen.takeDown(); return; }
  for (;;) {
    t = clock();
    if (t >= look) {                                                    // twice a second: look around
      look = t + 0.5;
      if ($.getppid() !== parent) { screen.takeDown(); return; }       // the loop is gone: so is the dog
      const want = wanted();
      if (!leaving && !want) leaving = true;
      else if (leaving && want) { leaving = false; try { say("up"); } catch (e) { screen.takeDown(); return; } }
      seen = !hidden();
      if (t >= beat) {
        beat = t + 1;
        try { say("."); } catch (e) { screen.takeDown(); return; }
      }
      if (t >= survey) {                                                // a display came or went: windows again
        survey = t + 2;
        if (!ghost) takeEvents();
        const now = displays();
        if (now.length && layoutOf(now) !== layout) {
          world = now;
          layout = layoutOf(now);
          screen.build(world);
          c.zzz = c.mode === "sleep";
          c.replan = true;                                              // the new windows have no glide yet
        }
      }
    }
    if (!seen) { delay(Math.max(0.01, look - clock())); continue; }   // nobody sees it: it waits
    const o = think(c, t, pointer(), leaving, world);
    if (o.done) { screen.takeDown(); try { say("bye"); } catch (e) {} return; }
    screen.show(c, o, t);
    delay(Math.min(nextLook(c, t), Math.max(0.01, look - t)));
  }
}

// The dog chasing a made-up pointer on a made-up Mac: a laptop display and a bigger one to its right.
function sim() {
  const world = [{ x: 0, y: 0, w: 1512, h: 982 }, { x: 1512, y: -200, w: 2560, h: 1440 }];
  const path = [   // [time, x, y]: the pointer glides from one to the next
    [0, 700, 500], [4, 700, 500], [5, 300, 300], [24, 300, 300], [24.4, 330, 320], [26, 1100, 700], [28, 1100, 700],
    [28.2, 1120, 690], [30, 1120, 690], [32, 2600, 400], [54, 2600, 400], [54.5, 2640, 420], [58, 2640, 420],
  ];
  const at = t => {
    let i = 0;
    while (i + 1 < path.length && path[i + 1][0] <= t) i++;
    if (i + 1 >= path.length) return { x: path[i][1], y: path[i][2] };
    const [t0, x0, y0] = path[i], [t1, x1, y1] = path[i + 1], k = (t - t0) / (t1 - t0);
    return { x: x0 + (x1 - x0) * k, y: y0 + (y1 - y0) * k };
  };
  let t = 0, last = "", shown = -1;
  const c = newDog(t, at(0), world), lines = [];
  for (; t < 85;) {
    const p = at(t), o = think(c, t, p, t >= 75, world), here = where(c, t);
    const running = c.mode === "run" || c.mode === "leave";
    const face = c.face > 0 ? "right" : "left", zzz = c.zzz ? "zzz" : "";
    const key = [c.mode, running ? "" : c.pic, face, zzz].join(" "), line = [c.mode, c.pic, face, zzz].join(" ");
    if (key !== last || (running && t - shown >= 0.5)) {
      shown = t;
      lines.push(t.toFixed(2).padStart(6) + "  " + line.padEnd(30) + " dog " + Math.round(here.x) + "," + Math.round(here.y) +
        "  pointer " + Math.round(p.x) + "," + Math.round(p.y));
      last = key;
    }
    if (o.done) { lines.push(t.toFixed(2).padStart(6) + "  gone"); break; }
    t += nextLook(c, t);
  }
  say(lines.join("\n"));
}

function run(argv) {
  const mode = argv[0] || "", art = readPictures(argv[2], argv[3]);
  if (art.problems.length) {
    complain("the pictures: " + art.problems.slice(0, 8).join("; "));
    if (mode !== "sheet") return;
  }
  HALF_W = art.w * PT / 2;
  HALF_H = art.h * PT / 2;
  NEAR = Math.round(NEAR_W * art.w * PT);
  AWAY = Math.round(AWAY_W * art.w * PT);
  STRIDE = Math.min(RUN * STEP, STRIDE_W * art.w * PT);
  if (mode === "sheet") return sheet(art, argv[1]);
  if (mode === "sim") return sim();
  if (mode === "live" || mode === "ghost") return live(argv[1], art, mode === "ghost");
  complain("unknown mode " + mode);
}
'

# The tools (see the top): they draw into a file or print, and stop.
case ${1-} in
  (--sheet)
    [[ -n ${2-} ]] || { print -u2 -- "usage: zsh startup.zsh --sheet <file.png>"; exit 2 }
    exec osascript -l JavaScript -e "$dog_js" -- sheet "${2:a}" "$dog_palette" "$dog_pictures" ;;
  (--sim)
    exec osascript -l JavaScript -e "$dog_js" -- sim "" "$dog_palette" "$dog_pictures" ;;
  ("") ;;
  (*) print -u2 -- "usage: zsh startup.zsh [--sheet <file.png> | --sim]"; exit 2 ;;
esac

zmodload zsh/datetime zsh/zselect zsh/system || { print -u2 -- "dog: zsh modules datetime/zselect/system are missing"; exit 1 }
zmodload -F zsh/files b:zf_mkdir b:zf_rm || { print -u2 -- "dog: zsh module files is missing"; exit 1 }

cell="{{CELL_ID}}"
dir="${DESMAPTIC_STORAGE:-$HOME/Library/Application Support/Desmaptic/ScriptStorage}/gallery/$cell"
until_file="$dir/until"         # the tap: the epoch second the dog goes home by itself. Gone: no dog
go_file="$dir/out"              # this loop: here while it wants the dog out. The overlay watches it
red="#FF453A"                   # the colour of the button while the dog is out
overlay_mode=live
[[ ${DOG_GHOST-} == 1 ]] && overlay_mode=ghost

opid=""                 # the overlay
post_fd=0 post_pid=0    # a post on its way: the pipe its answer comes back on, and its curl
# stop_overlay [signal]: ends the overlay (TERM; KILL for one that does not answer). Its windows go with it.
stop_overlay() { [[ -n $opid ]] && kill -${1:-TERM} $opid 2>/dev/null; opid="" }
# drop_post: forgets a post on its way and ends its curl.
drop_post() { (( post_pid )) && kill $post_pid 2>/dev/null; (( post_fd )) && exec {post_fd}<&-; post_fd=0 post_pid=0 }
trap 'stop_overlay; drop_post; zf_rm -f -- $go_file; exit 0' TERM INT HUP
trap 'stop_overlay; drop_post' EXIT

# REPLY = the second the dog goes home, when the tap left one that is still ahead. Returns 1 without: no dog.
dog_until() {
  local line=""
  REPLY=""
  { IFS= read -r line < $until_file } 2>/dev/null
  [[ $line == <-> ]] && (( ${#line} <= 12 && line > EPOCHSECONDS && line <= EPOCHSECONDS + 86400 )) || return 1
  REPLY=$line
}

# The overlay, as a coprocess: its lines ("up", a "." every second, "bye") come back to this loop.
start_overlay() {
  zf_mkdir -p -- $dir 2>/dev/null
  { : >> $go_file } 2>/dev/null || { print -u2 -- "dog: cannot write in $dir"; return 1 }
  coproc osascript -l JavaScript -e "$dog_js" -- $overlay_mode $go_file "$dog_palette" "$dog_pictures"
  opid=$! began=$EPOCHSECONDS heard=$EPOCHREALTIME said_bye=0
}

# post_start <out | rest>: sends it to the button without waiting for the answer. curl runs beside this loop
# (first its pid, then the body and the status on the last line come back on post_fd); post_check reads it. The
# token goes from the environment into the request by curl itself, never on a command line.
post_start() {
  local json
  if [[ $1 == out ]]; then json="{\"cellId\":\"$cell\",\"icon\":\"dog.fill\",\"color\":\"$red\"}"
  else json="{\"cellId\":\"$cell\",\"reset\":true}"; fi
  if [[ ${DOG_DRY-} == 1 ]]; then print -u2 -- "dog: would post $json"; shown=$1; return 0; fi
  exec {post_fd}< <(print -r -- $sysparams[pid]; exec curl -q -sS --max-time 3 -w '\n%{http_code}\n' \
    --variable '%DESMAPTIC_TOKEN=' --expand-header 'Authorization: Bearer {{DESMAPTIC_TOKEN}}' \
    -H 'Content-Type: application/json' --data-binary "$json" http://127.0.0.1:9848/api/update-button 2>&1) ||
    { post_fd=0; return 1 }
  post_pid=0 posting=$1 answer=""
  { IFS= read -r -t 1 -u $post_fd post_pid } 2>/dev/null
  [[ $post_pid == <-> ]] || post_pid=0
}

# post_check: never waits — it takes only the bytes already there (sysread, not a line read that would wait for
# the rest of a line). Once the whole answer is in: shown = what was posted when the agent took it; otherwise
# the failure is reported once and the next try waits 2 s.
post_check() {
  local chunk
  while zselect -t 0 -r $post_fd; do
    if sysread -i $post_fd chunk 2>/dev/null; then answer+=$chunk; continue; fi
    exec {post_fd}<&-                               # the end (or a broken pipe): the post is over
    post_fd=0 post_pid=0
    answer=${answer%$'\n'}
    if [[ ${answer##*$'\n'} == 200 ]]; then shown=$posting failing=0
    else
      (( failing )) || print -u2 -- "dog: update-button did not take it: ${${answer//$'\n'/ }[1,200]}"
      failing=1 retry_at=$(( EPOCHSECONDS + 2 ))
    fi
    return
  done
}

zf_rm -f -- $go_file 2>/dev/null        # left behind by a loop that was killed
waits=(5 10 20 40 60)                   # after the overlay failed: seconds before the next try
shown=""                # what the button shows: out, rest; "" not known yet (so the first pass posts rest)
up=0                    # the overlay said the dog is out: the button shows it
fails=0 start_at=0      # the overlay failed so many times in a row; when to try again
stop_by=0               # after a stop: when an overlay still running is ended
retry_at=0 failing=0    # after a failed post: when to post again; a failure was reported
odd=0                   # the overlay printed something unexpected (reported once)
last_pass=$EPOCHREALTIME
while true; do
  now=$EPOCHSECONDS
  # This loop was not running for a while (stopped, the Mac asleep): it cannot know whether the overlay spoke
  # meanwhile, so it listens again from now instead of calling it stuck.
  (( EPOCHREALTIME - last_pass > 2 )) && heard=$EPOCHREALTIME
  last_pass=$EPOCHREALTIME
  if dog_until; then want=1; else want=0; fi
  if (( want )); then
    stop_by=0
    [[ -e $go_file ]] || { : >> $go_file } 2>/dev/null
    [[ -z $opid ]] && (( now >= start_at )) && { start_overlay || start_at=$(( now + 30 )) }
  else
    up=0 fails=0 start_at=0
    [[ -e $go_file ]] && zf_rm -f -- $go_file
    if [[ -n $opid ]]; then             # the dog runs off the screen and the overlay quits by itself
      (( stop_by )) || stop_by=$(( now + 12 ))
      (( now >= stop_by )) && { print -u2 -- "dog: the overlay did not stop by itself; ended"; stop_overlay KILL }
    fi
  fi

  if [[ -n $opid ]]; then
    waited=$EPOCHREALTIME
    if { IFS= read -r -t 0.25 -p line } 2>/dev/null; then
      heard=$EPOCHREALTIME
      case $line in
        (up) up=1 ;;
        (.) ;;
        (bye) said_bye=1 ;;
        (*) (( odd )) || print -u2 -- "dog: the overlay printed something unexpected"; odd=1 ;;
      esac
    elif (( EPOCHREALTIME - waited < 0.2 )); then     # no wait, no line: the overlay is gone
      opid="" stop_by=0
      if (( want )); then
        up=0
        if (( said_bye )); then
          start_at=0                    # it had gone home; let out again since: a fresh visit
        else
          now=$EPOCHSECONDS
          (( now - began >= 60 )) && fails=0
          start_at=$(( now + waits[fails < 5 ? fails + 1 : 5] ))
          print -u2 -- "dog: the overlay stopped; starting it again in $(( start_at - now )) s"
          (( fails++ ))
        fi
      fi
    elif (( EPOCHREALTIME - waited > 2 )); then       # this wait took far longer than asked: not running either
      heard=$EPOCHREALTIME
    elif (( EPOCHREALTIME - heard > 5 )); then        # it says something every second: silent longer, it is stuck
      print -u2 -- "dog: the overlay went quiet; ending it"
      stop_overlay KILL
      up=0 start_at=$(( EPOCHSECONDS + 5 ))
    fi
  elif (( post_fd )); then
    zselect -t 25 -r $post_fd                         # a quarter of a second, or until the answer comes
  else
    zselect -t 25
  fi

  if (( want && up )); then face=out; else face=rest; fi
  (( post_fd )) && post_check
  if (( ! post_fd )) && [[ $face != "$shown" ]] && (( EPOCHSECONDS >= retry_at )); then post_start $face; fi
done
