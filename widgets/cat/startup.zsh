// ---- What the cat does -----------------------------------------------------------------------------------
// Positions are the Mac global screen coordinates in points (NSEvent.mouseLocation: y grows upward, one space
// for all displays); the cat is at the middle of its picture.

let HALF_W = 32, HALF_H = 24;   // pt, half the picture: the cat keeps this far inside a display (run sets it)

