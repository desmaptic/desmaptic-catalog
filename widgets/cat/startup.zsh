cat_js='
ObjC.import("AppKit");
ObjC.import("QuartzCore");
ObjC.import("CoreGraphics");
ObjC.bindFunction("getppid", ["int", []]);

// The cat on the Mac screen: one see-through window per display above everything (full screen apps too, every
// Space), clicks pass through, never focused, no Dock icon. The cat is one layer in every window, so it runs from
// one display onto the next. A run is a few Core Animation glides (speeding up, running on, braking) that the
// window server plays at the refresh rate of the display; this process looks ten times a second while the cat
// runs (a new glide only when the pointer has gone elsewhere), five while it sits and three while it sleeps,
// and swaps the pictures. The pictures are drawn once into bitmaps (a rectangle per run of pixels) and shown
// without smoothing (a pixel is a point: 2 x 2 on a Retina display), so every pixel stays sharp. A CGImage handed
// to an id argument goes through ObjC.castRefToObject (a bare ref arrives as a dictionary and draws nothing),
// CFRelease from JXA crashes, and every colour is a CoreGraphics one kept for the whole process.
//
// argv: <mode> <file> <palette> <pictures>
//   live <file>   the cat, while the loop keeps <file>. Gone: the cat runs off the screen and the process quits
//                 ("bye"); back while it runs off: it comes back. Prints "up" once the cat is out and "." every
//                 second; quits at once when the loop that started it is gone (its parent changes).
//   ghost <file>  the same with no window at all: what the cat does goes to stderr, a line per change.
//   sheet <png>   every picture, facing right and left, on light and on dark, magnified 4 times. No window.
//   sim           the cat chasing a made-up pointer over two made-up displays for 70 s, a line per change.

const PT = 1;           // points per pixel of a picture: the 64 x 48 pictures are 64 x 48 pt on the screen
const RUN = 320;        // pt/s: the cat at full run
const NEAR = 44;        // pt from the middle of the cat to the pointer: there it stops and sits down
const AWAY = 84;        // pt: the pointer this far from the sitting cat makes it run again
const DOZE = 8;         // s: the pointer still this long, the cat yawns and falls asleep
const ACC = RUN / 0.25;               // pt/s2: from a stand to full run in a quarter of a second
const DEC = RUN * RUN / (2 * 64);     // pt/s2: from full run to a stand in 64 pt
const STEP = 0.1;       // s: the running cat looks where the pointer is this often
const STRIDE = 28;      // pt run per running picture: the pictures follow the ground, so the feet never slide
const LEAVE_MAX = 8;    // s: a cat sent away is gone after this long even if it has not reached the edge

// What the cat does: [picture, seconds] in order. Pictures are named in the text above this program.
const RUN_PICS = ["run1", "run2", "run3"];
const ACTS = {
  blink: [["blink", 0.16]],
  wash: repeat([["wash1", 0.22], ["wash2", 0.22]], 4),
  scratch: repeat([["scratch1", 0.08], ["scratch2", 0.08]], 7),
  yawn: [["yawn1", 0.25], ["yawn2", 0.9], ["yawn1", 0.2]],
};
const IDLE = ["wash", "wash", "scratch", "scratch", "blink", "blink", "blink", "yawn"];   // picked at random
const DOZE_OFF = [["yawn1", 0.25], ["yawn2", 1.1], ["yawn1", 0.25], ["blink", 0.6]];
const SLEEP = [["sleep1", 1.3], ["sleep2", 1.3]];   // over and over, while z letters float up
const WAKE = [["alert", 0.5]];
const START = [["alert", 0.18]];
const Z_RISE = 2.7, Z_GAP = 0.9;                    // s: one z floats up this long; the next starts this much later

function repeat(list, n) { let all = []; for (let i = 0; i < n; i++) all = all.concat(list); return all; }

const out = $.NSFileHandle.fileHandleWithStandardOutput;
const err = $.NSFileHandle.fileHandleWithStandardError;
function say(text) { out.writeData($(text + "\n").dataUsingEncoding($.NSUTF8StringEncoding)); }
function complain(text) { err.writeData($("cat: " + text + "\n").dataUsingEncoding($.NSUTF8StringEncoding)); }

// ---- The pictures ----------------------------------------------------------------------------------------

// { colours: letter -> [r, g, b], pics: name -> rows, w, h, problems }. Cat pictures are all the size of "sit".
function readPictures(paletteText, picturesText) {
  const colours = {}, pics = {}, problems = [];
  for (const line of (paletteText || "").split("\n")) {
    const m = line.match(/^\s*(\S)\s+#?([0-9A-Fa-f]{6})(\s|$)/);
    if (m) colours[m[1]] = [0, 2, 4].map(i => parseInt(m[2].substr(i, 2), 16) / 255);
  }
  let name = null;
  for (const raw of (picturesText || "").split("\n")) {
    const line = raw.trim();
    if (!line) continue;
    const head = line.match(/^=\s*(\S+)/);
    if (head) { name = head[1]; pics[name] = []; continue; }
    if (name) pics[name].push(line);
    else problems.push("a row comes before the first picture name");
  }
  const size = rows => [rows.reduce((m, r) => Math.max(m, r.length), 0), rows.length];
  const [w, h] = pics.sit ? size(pics.sit) : [0, 0];
  const needed = new Set(["sit", "z"].concat(RUN_PICS));
  for (const list of [DOZE_OFF, SLEEP, WAKE, START].concat(Object.values(ACTS))) for (const [p] of list) needed.add(p);
  for (const p of needed) if (!pics[p]) problems.push("no picture named " + p);
  for (const [n, rows] of Object.entries(pics)) {
    if (n !== "z" && (size(rows)[0] !== w || rows.length !== h)) problems.push("picture " + n + " is not " + w + " x " + h + " like sit");
    rows.forEach((r, y) => { for (const c of r) if (c !== "." && !colours[c]) problems.push("picture " + n + ", row " + (y + 1) + ": no colour for " + c); });
  }
  return { colours: colours, pics: pics, w: w, h: h, problems: problems };
}

const space = $.CGColorSpaceCreateWithName($.kCGColorSpaceSRGB);

// The CoreGraphics colours of the palette, made once and kept.
function cgColours(art) {
  const cg = {};
  for (const [c, v] of Object.entries(art.colours)) cg[c] = $.CGColorCreateSRGB(v[0], v[1], v[2], 1);
  return cg;
}

// One picture into a bitmap of its own size, a pixel per letter; flip: the mirror image (the cat facing left).
function bitmap(rows, cg, flip) {
  const w = rows.reduce((m, r) => Math.max(m, r.length), 0), h = rows.length;
  const ctx = $.CGBitmapContextCreate(null, w, h, 8, 0, space, 1);      // RGBA, premultiplied
